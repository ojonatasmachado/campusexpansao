{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "CE.X Design Tokens",
  "version": "1.0.0",
  "description": "Tokens de design da CE.X · Campus Expansão. Consumir como fonte da verdade para front-end.",
  "color": {
    "ink":        { "value": "#0E110D", "type": "color", "description": "Fundo primário (preto-verde profundo)" },
    "graphite":   { "value": "#181B16", "type": "color", "description": "Fundo de cards / superfícies elevadas" },
    "card":       { "value": "#1F221C", "type": "color", "description": "Superfície de card alternativa" },
    "border":     { "value": "#25291F", "type": "color", "description": "Linha sutil" },
    "border-2":   { "value": "#2E3327", "type": "color", "description": "Linha mais visível" },
    "olive":      { "value": "#7A9E3F", "type": "color", "description": "Acento primário da marca" },
    "olive-soft": { "value": "#94B85C", "type": "color", "description": "Hover / destaque claro" },
    "olive-deep": { "value": "#4F6B26", "type": "color", "description": "Acento sobre fundos claros (creme)" },
    "olive-dim":  { "value": "rgba(122,158,63,0.10)", "type": "color", "description": "Fundo tênue do acento" },
    "olive-line": { "value": "rgba(122,158,63,0.28)", "type": "color", "description": "Borda do acento" },
    "cream":      { "value": "#EDE6D3", "type": "color", "description": "Cor quente / materiais devocionais e impressos" },
    "cream-soft": { "value": "#F6F1E0", "type": "color", "description": "Creme mais claro" },
    "white":      { "value": "#FAFAF7", "type": "color", "description": "Texto principal sobre escuro" },
    "light":      { "value": "#E6E5DD", "type": "color", "description": "Texto secundário claro" },
    "muted":      { "value": "#8B8C82", "type": "color", "description": "Texto secundário / legendas" },
    "subtle":     { "value": "#555650", "type": "color", "description": "Texto terciário / metadados" },
    "danger":     { "value": "#D17066", "type": "color", "description": "Erro / estado destrutivo" }
  },
  "font": {
    "family": {
      "sans": { "value": "Inter, -apple-system, BlinkMacSystemFont, sans-serif", "type": "fontFamily", "description": "Display + corpo + UI" },
      "mono": { "value": "JetBrains Mono, SF Mono, ui-monospace, monospace", "type": "fontFamily", "description": "Metadados, eyebrows, rótulos técnicos" }
    },
    "weight": {
      "light": { "value": 300 }, "regular": { "value": 400 }, "medium": { "value": 500 },
      "semibold": { "value": 600 }, "bold": { "value": 700 }, "extrabold": { "value": 800 }
    },
    "scale": {
      "display":  { "value": { "size": "64px", "weight": 700, "tracking": "-0.045em", "lineHeight": "1.0" } },
      "h1":       { "value": { "size": "44px", "weight": 700, "tracking": "-0.035em", "lineHeight": "1.05" } },
      "h2":       { "value": { "size": "30px", "weight": 600, "tracking": "-0.025em", "lineHeight": "1.15" } },
      "h3":       { "value": { "size": "22px", "weight": 600, "tracking": "-0.02em",  "lineHeight": "1.2" } },
      "body-lg":  { "value": { "size": "18px", "weight": 400, "tracking": "0",        "lineHeight": "1.6" } },
      "body":     { "value": { "size": "15px", "weight": 400, "tracking": "0",        "lineHeight": "1.7" } },
      "small":    { "value": { "size": "13px", "weight": 400, "tracking": "0",        "lineHeight": "1.6" } },
      "eyebrow":  { "value": { "size": "11px", "weight": 500, "tracking": "0.18em",   "transform": "uppercase", "family": "mono" } }
    }
  },
  "spacing": {
    "1": { "value": "4px" }, "2": { "value": "8px" }, "3": { "value": "12px" }, "4": { "value": "16px" },
    "5": { "value": "24px" }, "6": { "value": "32px" }, "7": { "value": "48px" }, "8": { "value": "64px" }
  },
  "radius": {
    "sm": { "value": "4px" }, "md": { "value": "8px" }, "lg": { "value": "14px" }, "pill": { "value": "100px" }
  },
  "motion": {
    "ease": { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "description": "expo.out — entradas" },
    "duration-fast": { "value": "0.18s" }, "duration-base": { "value": "0.4s" }, "duration-slow": { "value": "0.7s" }
  }
}
