{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "CE.X Design Tokens",
  "version": "2.0.0",
  "description": "Tokens da CE.X · Campus Expansão. Fonte da verdade compartilhada com tokens.css. Paleta quente, sem azul.",
  "color": {
    "neutral": {
      "ink":        { "value": "#0E110D", "comment": "fundo dominante" },
      "graphite":   { "value": "#181B16" },
      "graphite-2": { "value": "#14170F" },
      "card":       { "value": "#1F221C" },
      "border":     { "value": "#25291F" },
      "border-2":   { "value": "#2E3327" },
      "cream":      { "value": "#EDE6D3" },
      "cream-soft": { "value": "#F6F1E0" },
      "white":      { "value": "#FAFAF7" },
      "light":      { "value": "#E6E5DD" },
      "muted":      { "value": "#8B8C82" },
      "subtle":     { "value": "#555650" }
    },
    "olive": {
      "base": { "value": "#7A9E3F", "comment": "acento-mestre, <=15% da peca" },
      "soft": { "value": "#94B85C" },
      "deep": { "value": "#4F6B26" }
    },
    "shelf": {
      "comment": "Acentos QUENTES. Cada um codifica uma estante/nivel. Aplicar via classe .cat-{nome}. Nunca azul.",
      "sand":  { "value": "#E2D6B4" },
      "wheat": { "value": "#CBA95C" },
      "amber": { "value": "#D6A23E" },
      "clay":  { "value": "#C5805A" },
      "terra": { "value": "#B5694A" },
      "rust":  { "value": "#9C5A33" },
      "cocoa": { "value": "#6F523A" }
    },
    "state": {
      "danger":  { "value": "#D17066" },
      "success": { "value": "#7A9E3F" },
      "warning": { "value": "#D6A23E" }
    }
  },
  "space": {
    "1": { "value": "4px" }, "2": { "value": "8px" }, "3": { "value": "12px" },
    "4": { "value": "16px" }, "5": { "value": "24px" }, "6": { "value": "32px" },
    "7": { "value": "48px" }, "8": { "value": "64px" }
  },
  "radius": {
    "sm": { "value": "4px" }, "md": { "value": "8px" },
    "lg": { "value": "14px" }, "pill": { "value": "100px" }
  },
  "font": {
    "sans": { "value": "Inter, -apple-system, BlinkMacSystemFont, sans-serif" },
    "mono": { "value": "'JetBrains Mono', 'SF Mono', ui-monospace, monospace" }
  },
  "motion": {
    "ease":      { "value": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "dur-fast":  { "value": "0.18s" },
    "dur-base":  { "value": "0.4s" },
    "dur-slow":  { "value": "0.7s" }
  }
